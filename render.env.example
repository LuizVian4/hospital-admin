# Web Service único (API + frontend) — render.yaml na raiz
# No painel: Root Directory vazio, Dockerfile Path packages/backend/Dockerfile
#
# DATABASE_URL: Internal Database URL do Postgres no mesmo serviço/região.
# O blueprint já liga essa variável. Para conectar da sua máquina, use a External Database URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST/escala_hospital

NODE_ENV=production

# Gere um segredo forte (ex.: openssl rand -base64 48).
# Se estiver migrando sessões existentes, reuse o JWT_SECRET atual.
JWT_SECRET=altere-este-segredo-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Produção serve o frontend na mesma origem da API. Não defina VITE_API_URL no Render:
# o Vite grava essa URL no bundle no momento do build.

# Opcional. Em desenvolvimento local o padrão é http://localhost:5173.
# CORS_ORIGINS=http://localhost:5173

# Opcional, só se o cookie precisar valer em subdomínios (app + api).
# COOKIE_DOMAIN=.escala360.app

# A URL interna do Render não usa SSL. A externa (*.render.com) liga SSL sozinha.
# DATABASE_SSL=require
